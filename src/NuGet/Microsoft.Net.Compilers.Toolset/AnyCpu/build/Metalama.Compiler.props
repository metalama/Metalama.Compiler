<!--
<Metalama>
  Originally, this file is named Microsoft.Net.Compilers.Toolset.props and it's been located in ..\build folder. 
  The renaming is done because NuGet requires the .props file to be named equaly to the containing NuGet package to be imported automatically.
</Metalama>
 -->

<Project>

  <PropertyGroup>
    <!-- <Metalama> Added .Net version switch -->
    <!-- this version does not work on .Net SDK versions strictly less than 6.0.300 -->
    <!-- <_MetalamaBuildRuntimeVersion>$([System.Environment]::Version)</_MetalamaBuildRuntimeVersion> -->

    <_MetalamaBuildRuntimeDescription>$([System.Runtime.InteropServices.RuntimeInformation]::FrameworkDescription)</_MetalamaBuildRuntimeDescription>
    <_MetalamaBuildRuntimeVersion>$([System.Text.RegularExpressions.Regex]::Match($(_MetalamaBuildRuntimeDescription), '\d+(\.\d+)+').Value)</_MetalamaBuildRuntimeVersion>
    
    <_RoslynTargetDirectoryName Condition="'$(MSBuildRuntimeType)' == 'Core' AND $([MSBuild]::VersionLessThan('$(_MetalamaBuildRuntimeVersion)', '9.0'))">net8.0</_RoslynTargetDirectoryName>
    <_RoslynTargetDirectoryName Condition="'$(MSBuildRuntimeType)' == 'Core' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_MetalamaBuildRuntimeVersion)', '9.0')) AND $([MSBuild]::VersionLessThan('$(_MetalamaBuildRuntimeVersion)', '10.0'))">net9.0</_RoslynTargetDirectoryName>
    <_RoslynTargetDirectoryName Condition="'$(MSBuildRuntimeType)' == 'Core' AND $([MSBuild]::VersionGreaterThanOrEquals('$(_MetalamaBuildRuntimeVersion)', '10.0'))">net10.0</_RoslynTargetDirectoryName>

    <!--
      https://github.com/metalama/Metalama.Compiler/issues/194
      Follow the compiler host that the .NET SDK itself chose, instead of deciding from
      $(MSBuildRuntimeType) alone.

      Since .NET SDK 10, Microsoft.NET.Sdk.BeforeCommon.targets redirects RoslynTargetsPath to
      <sdk>\Roslyn\binfx under .NET Framework MSBuild. That directory holds only a .NET Framework
      MSBuild *task* (MSBuild.exe loads tasks in-process, so the task must be net472), while the
      *compiler* stays CoreCLR in <sdk>\Roslyn\bincore and is launched out of process. SDK 8 and 9
      have no such redirect and really do use the .NET Framework compiler.

      The condition below mirrors the SDK's own, from the Choose block in
      Microsoft.NET.Sdk.BeforeCommon.targets that selects $(RoslynCompilerType). The SDK's rule is a
      capability check, not a version check: it picks the CoreCLR compiler whenever a dotnet host is
      available, and only falls back to the .NET Framework compiler when there is none (a fallback
      SDK 10 additionally warns about as deprecated). We use the same inputs so that we follow the
      same rule.

      $(DOTNET_HOST_PATH) is an environment variable, so unlike $(NETCoreSdkVersion) or
      $(NetCoreRoot) it is available this early. Those two come from
      Microsoft.NETCoreSdk.BundledVersions.props, which the SDK imports only after
      Microsoft.Common.props has pulled in this file, so they are empty here. $(MSBuildSDKsPath) is
      no use either: under .NET Framework MSBuild it points at the Visual Studio MSBuild\Sdks
      directory, not at the .NET SDK. And $(RoslynTargetsPath) is set later still, in .targets.

      $(RoslynCompilerType) is read before it is overwritten below, so 'Framework' works as the
      opt-out, exactly as in the SDK.
    -->
    <_UseRoslynBridgeTask Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(RoslynCompilerType)' != 'Framework' AND ('$(DOTNET_HOST_PATH)' != '' OR '$(DOTNET_EXPERIMENTAL_HOST_PATH)' != '')">true</_UseRoslynBridgeTask>

     <RoslynCompilerType>Metalama</RoslynCompilerType>

    <!-- The bridge task lives one directory below the CoreCLR compiler, because
         ManagedToolTask.GetToolDirectory() resolves '..\bincore' when it is the bridge (#194). -->
    <_RoslynTargetDirectoryName Condition="'$(_UseRoslynBridgeTask)' == 'true'">net10.0\binfx</_RoslynTargetDirectoryName>

    <!-- Use ARM64-native compiler on ARM64 Windows to avoid x64 emulation (#104) -->
    <_RoslynTargetDirectoryName Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(PROCESSOR_ARCHITECTURE)' == 'ARM64' AND '$(_RoslynTargetDirectoryName)' == ''">net472-arm64</_RoslynTargetDirectoryName>
    <!-- </Metalama> -->
    
    <_RoslynTargetDirectoryName Condition="'$(MSBuildRuntimeType)' != 'Core' AND '$(_RoslynTargetDirectoryName)' == ''">net472</_RoslynTargetDirectoryName>
    <_RoslynTasksDirectory>$(MSBuildThisFileDirectory)..\tasks\$(_RoslynTargetDirectoryName)\</_RoslynTasksDirectory>
    <RoslynTasksAssembly>$(_RoslynTasksDirectory)Microsoft.Build.Tasks.CodeAnalysis.dll</RoslynTasksAssembly>
    <!-- <Metalama> The bridge task has a different assembly name (#194). -->
    <RoslynTasksAssembly Condition="'$(_UseRoslynBridgeTask)' == 'true'">$(_RoslynTasksDirectory)Microsoft.Build.Tasks.CodeAnalysis.Sdk.dll</RoslynTasksAssembly>
    <!-- </Metalama> -->
    <UseSharedCompilation Condition="'$(UseSharedCompilation)' == ''">true</UseSharedCompilation>
    <CSharpCoreTargetsPath>$(_RoslynTasksDirectory)Microsoft.CSharp.Core.targets</CSharpCoreTargetsPath>
    <VisualBasicCoreTargetsPath>$(_RoslynTasksDirectory)Microsoft.VisualBasic.Core.targets</VisualBasicCoreTargetsPath>
  </PropertyGroup>

  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.Csc" AssemblyFile="$(RoslynTasksAssembly)" />
  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.Vbc" AssemblyFile="$(RoslynTasksAssembly)" />
  <UsingTask TaskName="Microsoft.CodeAnalysis.BuildTasks.CopyRefAssembly" AssemblyFile="$(RoslynTasksAssembly)" />

  <!-- <Metalama> -->
  <PropertyGroup>
    <WarningsAsErrors>$(WarningsAsErrors);LAMA0621</WarningsAsErrors>

    <!--
      Disable torn SDK handling (see https://github.com/dotnet/sdk/blob/main/documentation/general/torn-sdk.md).
      When an older version of MSBuild is used with a newer .Net SDK 9+, the SDK will download and attempt to use its own version of Csc.
      Metalama.Compiler takes priority (because its <UsingTask> is processed first), so torn SDK handling does nothing.
      We disable it anyway, but it's just to avoid an unnecessary package download.
      -->
    <BuildWithNetFrameworkHostedCompiler>false</BuildWithNetFrameworkHostedCompiler>
  </PropertyGroup>
  
  <ItemGroup>
    <CompilerVisibleProperty Include="MetalamaDebugTransformedCode" />
    <CompilerVisibleProperty Include="MetalamaEmitCompilerTransformedFiles" />
    <CompilerVisibleProperty Include="MetalamaCompilerTransformerOrder" />
    <CompilerVisibleProperty Include="MetalamaCompilerTransformedFilesOutputPath" />
    <CompilerVisibleProperty Include="MetalamaDebugCompiler" />
    <CompilerVisibleProperty Include="MetalamaTransformedCodeAnalyzers" />
    <CompilerVisibleProperty Include="MetalamaLicense" />
    <CompilerVisibleProperty Include="NETCoreSdkBundledVersionsProps" />
    <CompilerVisibleProperty Include="MSBuildProjectFullPath "/>

    <MetalamaTransformedCodeAnalyzer Include="Microsoft.CodeAnalysis.CSharp.RemoveUnusedMembers" />
    <MetalamaTransformedCodeAnalyzer Include="Microsoft.CodeAnalysis.CSharp.RemoveUnusedParametersAndValues" />
    <MetalamaTransformedCodeAnalyzer Include="Microsoft.CodeQuality.Analyzers.Maintainability.AvoidUnusedPrivateFieldsAnalyzer" />
  </ItemGroup>
  <!-- </Metalama> -->
  
</Project>
