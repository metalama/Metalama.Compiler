<Project>
  <PropertyGroup>
      <MetalamaTransformedCodeAnalyzers>@(MetalamaTransformedCodeAnalyzer,',')</MetalamaTransformedCodeAnalyzers>
  </PropertyGroup>

  <!--
    Metalama.Compiler ships a single CoreCLR flavour, net10.0, since .NET 8 and .NET 9 were dropped
    (metalama/Metalama#1876). Report the required version here rather than letting the build fail later while
    loading an assembly, which names neither the .NET SDK nor the version it must have.
    $(_MetalamaHostRuntimeTooOld) is computed in Metalama.Compiler.props.
  -->
  <Target Name="MetalamaCompilerCheckHostRuntime" BeforeTargets="CoreCompile" Condition="'$(_MetalamaHostRuntimeTooOld)' == 'true'">
    <Error Code="LAMA0622"
           Text="Metalama requires the .NET 10 SDK or later. MSBuild is running on .NET $(_MetalamaBuildRuntimeVersion), which cannot load the compiler. Install the .NET 10 SDK, or pin it with a global.json file." />
  </Target>
  <ItemGroup>
      <!-- For packages.config projects, it is necessary to explicitly include the analyzer as an ItemGroup. -->
      <Analyzer Condition="'$(IsRestoreTargetsFileLoaded)'!='True'" Include="$(MSBuildThisFileDirectory)/../analyzers/dotnet/cs/*.dll"/>
  </ItemGroup>

  <!--
    Hint the running .NET SDK's dotnet root to Metalama's analyzer-redirector
    (issue #180). $(MSBuildSDKsPath) under the .NET SDK MSBuild is
    "<dotnet-root>/sdk/<version>/Sdks", so its great-grandparent is the
    dotnet root. The redirector reads METALAMA_DOTNET_ROOT to enumerate
    installed SDKs for fall-back analyzer resolution.
  -->
  <!--
    Wrap the AssemblyFile path in MSBuild::Unescape: property functions (here
    Path.Combine) escape the MSBuild-special characters '(' and ')' in their
    result to '%28'/'%29', and a TaskFactory's AssemblyFile is consumed WITHOUT
    unescaping. When $(MSBuildToolsPath) contains parentheses — e.g. an x86 .NET
    SDK or VS Build Tools under 'C:\Program Files (x86)\...' — the literal
    '%28x86%29' would otherwise reach assembly loading and fail with MSB4175
    (issue #1699).
  -->
  <UsingTask TaskName="MetalamaSetEnvironmentVariable"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([MSBuild]::Unescape($([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))))">
    <ParameterGroup>
      <Name Required="true" ParameterType="System.String" />
      <Value Required="true" ParameterType="System.String" />
    </ParameterGroup>
    <Task>
      <Code Type="Fragment" Language="cs">
        System.Environment.SetEnvironmentVariable(Name, Value);
      </Code>
    </Task>
  </UsingTask>

  <Target Name="MetalamaSetDotnetRootHint" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildSDKsPath)' != ''">
    <PropertyGroup>
      <!-- Use forward slashes so this works on Linux / macOS MSBuild hosts too;
           Path.GetFullPath normalises to the host's native separator. -->
      <_MetalamaDotnetRoot>$([System.IO.Path]::GetFullPath('$(MSBuildSDKsPath)/../../..'))</_MetalamaDotnetRoot>
    </PropertyGroup>
    <MetalamaSetEnvironmentVariable Name="METALAMA_DOTNET_ROOT" Value="$(_MetalamaDotnetRoot)" />
  </Target>
</Project>