<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>

    <!-- VSIX -->
    <ExtensionInstallationRoot>CommonExtensions</ExtensionInstallationRoot>
    <ExtensionInstallationFolder>Microsoft\Templates\Editorconfig</ExtensionInstallationFolder>
    <VisualStudioInsertionComponent>Templates.Editorconfig.Setup</VisualStudioInsertionComponent>
    <SetupProductArch>Neutral</SetupProductArch>
    <IncludeAssemblyInVSIXContainer>false</IncludeAssemblyInVSIXContainer>
    <GeneratePkgDefFile>false</GeneratePkgDefFile>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Wizard\Microsoft.VisualStudio.Templates.Editorconfig.Wizard.csproj">
      <Name>Microsoft.VisualStudio.Templates.Editorconfig.Wizard</Name>
      <IncludeOutputGroupsInVSIX>BuiltProjectOutputGroup%3bGetCopyToOutputDirectoryItems</IncludeOutputGroupsInVSIX>
      <IncludeOutputGroupsInVSIXLocalOnly>DebugSymbolsProjectOutputGroup%3b</IncludeOutputGroupsInVSIXLocalOnly>
      <ForceIncludeInVSIX>true</ForceIncludeInVSIX>
    </ProjectReference>
    <None Include="source.extension.vsixmanifest" />
    <None Include="*.vstemplate" />
    <VSTemplate Include="Editorconfig.CS.Default.vstemplate">
      <OutputSubPath>General</OutputSubPath>
    </VSTemplate>
    <VSTemplate Include="Editorconfig.CS.DotNet.vstemplate">
      <OutputSubPath>General</OutputSubPath>
    </VSTemplate>
  </ItemGroup>

  <!-- <Metalama> -->
  <!-- UpdateTemplateVersion is an internal Microsoft package that the roslyn-consolidated mirror does not serve,
       and restore covers every project of Roslyn.slnx, so referencing it fails the whole restore with NU1101.
       Metalama does not build or ship these Visual Studio templates, so the reference and its target are skipped.
  <ItemGroup>
    <PackageReference Include="UpdateTemplateVersion" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
  </ItemGroup>
  -->
  <!-- </Metalama> -->

  <!-- rewriting of .vstemplate files to reference the correct assembly version number -->
  <UsingTask AssemblyFile="$(PkgUpdateTemplateVersion)\tools\net472\UpdateTemplateVersion.dll" TaskName="UpdateTemplateVersion" />
  <Target Name="UpdateAssemblyVersionInTemplates" BeforeTargets="GetZipFilesFromVSTemplates" Condition="'$(PkgUpdateTemplateVersion)' != ''"> <!-- <Metalama /> -->
    <ItemGroup>
      <_OriginalVSTemplate Include="@(VSTemplate)" />
    </ItemGroup>
    <UpdateTemplateVersion VSTemplatesToRewrite="@(VSTemplate)" AssemblyVersion="$(AssemblyVersion)" IntermediatePath="ModifiedTemplates">
      <Output TaskParameter="NewVSTemplates" ItemName="VSTemplate" />
    </UpdateTemplateVersion>
    <ItemGroup>
      <VSTemplate Remove="@(_OriginalVSTemplate)" />
    </ItemGroup>
  </Target>
</Project>
